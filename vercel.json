{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    { "source": "/start", "destination": "/prepare/index.html" },
    { "source": "/start/", "destination": "/prepare/index.html" },
    { "source": "/start/index.html", "destination": "/prepare/index.html" },
    { "source": "/start/sw.js", "destination": "/prepare/sw.js" },
    { "source": "/print", "destination": "/prepare/print.html" },
    { "source": "/print/", "destination": "/prepare/print.html" },
    { "source": "/print/index.html", "destination": "/prepare/print.html" },
    { "source": "/print/app.mjs", "destination": "/prepare/print.mjs" },
    { "source": "/print/printer.mjs", "destination": "/vendor/print/printer.mjs" },
    { "source": "/print/px10-protocol.mjs", "destination": "/vendor/print/px10-protocol.mjs" }
  ],
  "headers": [
    { "source": "/pointcloud/vendor/(.*).wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
  ]
}
